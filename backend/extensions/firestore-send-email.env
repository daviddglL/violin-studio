# Trigger Email (firestore-send-email) - parametros NO secretos. Versionado.
# SMTP_PASSWORD (secreto) y SMTP_CONNECTION_URI NO van aqui: en produccion son
# parametros secret de la extension (Secret Manager); en emulador, en
# extensions/firestore-send-email.env.local (gitignored).
MAIL_COLLECTION=mail
LOCATION=europe-west1
DEFAULT_FROM=Violin Studio <no-reply@violin-studio.invalid>
