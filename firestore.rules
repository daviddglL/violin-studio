rules_version = '2';
// Fase 2: se abre solo lo necesario para identidad; todo lo demás sigue cerrado.
// Convención: cada colección tiene un `match` explícito, aunque sea deny, para que el test de registro (7a) la detecte.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function emailVerified() { return request.auth.token.email_verified == true; }
    // Lectura de negocio: usa el claim, nunca el cuerpo del cliente.
    function hasConsent() { return request.auth.token.consentOk == true; }

    // Espeja a registerProfile (functions/src/profile). El servidor es la validación autoritativa:
    // las reglas cuentan unidades UTF-16 (un emoji cuenta 2) y `matches` no ofrece puntos de código,
    // así que aquí el límite de 40 es más estricto para caracteres fuera del BMP.
    // `trim()` de las reglas solo recorta ASCII, y RE2 no soporta \\p{Cn} (sin asignar) ni cubre con \\p{C}
    // los separadores Unicode. Por eso se usa una lista blanca: letras, marcas, números, puntuación, símbolos y
    // el espacio ASCII. Rechaza control/formato, sin asignar y NBSP/U+2003/U+2028... en cualquier posición.
    // registerProfile usa la misma lista blanca: si difieren, un perfil válido para el servidor no podría
    // editarse después. Única diferencia restante: la longitud (UTF-16 aquí, puntos de código allí).
    function validDisplayName(n) {
      return n is string && n == n.trim() && n.size() >= 1 && n.size() <= 40
        && n.matches('^[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S} ]+$');
    }
    function validEditable(d) {
      return validDisplayName(d.displayName)
        && d.instrument in ['violin', 'viola', 'cello', 'double_bass', 'other']
        && d.locale is string && d.locale.matches('^[a-z]{2}(-[A-Z]{2})?$');
    }

    // Práctica (fase 3): el doc de usuario manda sobre el claim (consentimiento revocado o borrado en curso).
    function isActiveDoc(u) { return u.consentStatus == 'granted' && !('deletion' in u); }
    function userDocActive(uid) { return isActiveDoc(get(/databases/$(database)/documents/users/$(uid)).data); }
    // Vinculo profesor-alumno: el doc `teacherLinks/{t}_{s}` existe <=> vinculo activo (solo Functions escribe).
    // El id `t_s` es ambiguo si un uid contiene '_' (a_b+c vs a+b_c): se comprueban los campos del doc, no solo su
    // existencia. Si el doc no existe, `get` da error y la regla deniega.
    function linkOk(t, s) {
      let l = get(/databases/$(database)/documents/teacherLinks/$(t + '_' + s)).data;
      return l.teacherUid == t && l.studentUid == s;
    }
    // Profesor vinculado con ambos docs activos. NUNCA mira el claim `role` (puede ir desfasado): manda el vinculo.
    // Accesos a documentos por evaluacion: 3 get (vinculo + 2 usuarios; limite de Firestore: 10 por peticion).
    // Coste: cada get/list del profesor factura 3 lecturas extra por peticion (list: una vez por consulta, no por doc).
    // Los `list` se evaluan una vez por consulta (no por doc); esta funcion no depende de `resource`.
    function isLinkedTeacher(s) {
      return isSignedIn() && emailVerified() && hasConsent()
        && linkOk(request.auth.uid, s) && userDocActive(s) && userDocActive(request.auth.uid);
    }
    function validNotes(d) { return !('notes' in d) || (d.notes is string && d.notes.size() <= 500); }
    // Sin campos de audio posibles: hasOnly cierra el esquema.
    function validSession(d) {
      return d.keys().hasOnly(['startedAt', 'durationSec', 'instrument', 'notes', 'createdAt'])
        && d.keys().hasAll(['startedAt', 'durationSec', 'instrument', 'createdAt'])
        && d.startedAt is timestamp && d.startedAt > timestamp.date(2020, 1, 1)
        // Tolerancia de 10 min: el reloj del dispositivo puede ir adelantado y la escritura offline no se espera.
        && d.startedAt <= request.time + duration.value(10, 'm')
        && d.durationSec is int && d.durationSec >= 1 && d.durationSec <= 43200
        && d.startedAt + duration.value(d.durationSec, 's') <= request.time + duration.value(10, 'm')
        && d.instrument in ['violin', 'viola', 'cello', 'double_bass', 'other']
        && validNotes(d) && d.createdAt == request.time;
    }

    match /users/{uid} {
      // También en parental_pending (pantalla de espera): sin gating por email ni consentimiento.
      allow get: if isOwner(uid);
      // Escritura crítica (R-e): claim al día Y estado real en el doc, no solo el token.
      allow update: if isOwner(uid) && emailVerified() && hasConsent()
        && resource.data.consentStatus == 'granted'
        // Borrado en curso (design: users.deletion): el claim puede ir desfasado, se mira el doc.
        && !('deletion' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'instrument', 'locale'])
        && validEditable(request.resource.data);
      allow list, create, delete: if false;

      // Append-only y solo Functions: el dueño únicamente lee.
      match /consents/{id} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }

      // id <= 64: el cliente usa UUIDs (36).
      match /practiceSessions/{id} {
        // Profesor vinculado: solo lectura. Accesos: dueño 0; profesor 3 (3 get).
        // create/update llaman a userDocActive una vez (1 get); delete 0.
        allow get, list: if isOwner(uid) || isLinkedTeacher(uid);
        allow create: if id.size() <= 64 && isOwner(uid) && emailVerified() && hasConsent() && userDocActive(uid)
          && validSession(request.resource.data);
        allow update: if isOwner(uid) && emailVerified() && hasConsent() && userDocActive(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])
          && validNotes(request.resource.data);
        allow delete: if isOwner(uid); // supresión siempre disponible, sin consentimiento
      }

      // Provisional (A5): deny total hasta que A6 defina las reglas de tareas. Existe para que el
      // registro de borrado (`assignments`, subcolección de users) tenga su `match` explícito.
      match /assignments/{id} { allow read, write: if false; }
    }

    // Colecciones del servidor (solo Admin SDK): deny explícito para que el test de registro las detecte.
    match /guardianRequests/{id} { allow read, write: if false; }
    match /guardianEmailLimits/{id} { allow read, write: if false; }
    match /mail/{id} { allow read, write: if false; }
    // Codigos de vinculo: ids HMAC, solo Functions (el profesor los lista via callable).
    match /teacherCodes/{id} { allow read, write: if false; }
    // Vinculos profesor-alumno: solo Functions escribe. Lectura por las partes; el `list` exige filtrar por el propio
    // uid (teacherUid o studentUid) para que la consulta quede acotada. Accesos por evaluacion: 0.
    match /teacherLinks/{id} {
      allow get, list: if isSignedIn() && emailVerified()
        && (resource.data.teacherUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
