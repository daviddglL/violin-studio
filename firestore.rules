rules_version = '2';
// Fase 2: se abre solo lo necesario para identidad; todo lo demás sigue cerrado.
// Convención: cada colección tiene un `match` explícito, aunque sea deny, para que el test de registro (7a) la detecte.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function emailVerified() { return request.auth.token.email_verified == true; }
    // Lectura de negocio: usa el claim, nunca el cuerpo del cliente.
    function hasConsent() { return request.auth.token.consentOk == true; }

    // Espeja a registerProfile (functions/src/profile). El servidor es la validación autoritativa:
    // las reglas cuentan unidades UTF-16 (un emoji cuenta 2) y `matches` no ofrece puntos de código,
    // así que aquí el límite de 40 es más estricto para caracteres fuera del BMP.
    // `trim()` de las reglas solo recorta ASCII, y RE2 no soporta \\p{Cn} (sin asignar) ni cubre con \\p{C}
    // los separadores Unicode. Por eso se usa una lista blanca: letras, marcas, números, puntuación, símbolos y
    // el espacio ASCII. Rechaza control/formato, sin asignar y NBSP/U+2003/U+2028... en cualquier posición.
    // registerProfile usa la misma lista blanca: si difieren, un perfil válido para el servidor no podría
    // editarse después. Única diferencia restante: la longitud (UTF-16 aquí, puntos de código allí).
    function validDisplayName(n) {
      return n is string && n == n.trim() && n.size() >= 1 && n.size() <= 40
        && n.matches('^[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S} ]+$');
    }
    function validEditable(d) {
      return validDisplayName(d.displayName)
        && d.instrument in ['violin', 'viola', 'cello', 'double_bass', 'other']
        && d.locale is string && d.locale.matches('^[a-z]{2}(-[A-Z]{2})?$');
    }

    // Práctica (fase 3): el doc de usuario manda sobre el claim (consentimiento revocado o borrado en curso).
    function isActiveDoc(u) { return u.consentStatus == 'granted' && !('deletion' in u); }
    function userDocActive(uid) { return isActiveDoc(get(/databases/$(database)/documents/users/$(uid)).data); }
    // Vinculo profesor-alumno: el doc `teacherLinks/{t}_{s}` existe <=> vinculo activo (solo Functions escribe).
    // El id `t_s` es ambiguo si un uid contiene '_' (a_b+c vs a+b_c): se comprueban los campos del doc, no solo su
    // existencia. Si el doc no existe, `get` da error y la regla deniega.
    function linkOk(t, s) {
      let l = get(/databases/$(database)/documents/teacherLinks/$(t + '_' + s)).data;
      return l.teacherUid == t && l.studentUid == s;
    }
    // Profesor vinculado con ambos docs activos. NUNCA mira el claim `role` (puede ir desfasado): manda el vinculo.
    // Accesos a documentos por evaluacion: 3 get (vinculo + 2 usuarios; limite de Firestore: 10 por peticion).
    // Coste: cada get/list del profesor factura 3 lecturas extra por peticion (list: una vez por consulta, no por doc).
    // Los `list` se evaluan una vez por consulta (no por doc); esta funcion no depende de `resource`.
    function isLinkedTeacher(s) {
      return isSignedIn() && emailVerified() && hasConsent()
        && linkOk(request.auth.uid, s) && userDocActive(s) && userDocActive(request.auth.uid);
    }
    // Consentimiento de grabacion vigente del perfil `u` (espeja `recordingOk` de storage.rules: `granted` y version
    // >= RECORDING_CONSENT_VERSION = 1; paridad en functions/test/unit/storage-rules-parity.test.ts). Ausente = none/0.
    function recordingGranted(u) {
      return u.get('recordingConsent', 'none') == 'granted' && u.get('recordingConsentVersion', 0) >= 1;
    }
    // Esquema cerrado de la revision (REQ-RVW-01). `reviewerUid` y las marcas de tiempo las fijan las reglas de escritura.
    function validReview(d) {
      return d.keys().hasOnly(['reviewerUid', 'verdict', 'text', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['reviewerUid', 'verdict', 'text', 'createdAt', 'updatedAt'])
        && d.reviewerUid is string && d.verdict in ['approved', 'needs_work']
        && d.text is string && d.text.size() <= 1000;
    }
    // Chat profesor-alumno (fase 4c): solo las dos partes de un vinculo vivo, con email verificado, consentimiento y ambos
    // docs activos. Mismo coste que isLinkedTeacher: 3 get (vinculo + 2 usuarios).
    function isChatParty(t, s) {
      return isSignedIn() && emailVerified() && hasConsent()
        && (request.auth.uid == t || request.auth.uid == s)
        && linkOk(t, s) && userDocActive(t) && userDocActive(s);
    }
    // Esquema cerrado del mensaje. `createdAt` es la hora del servidor. `expireAt` (politica TTL) lo calcula el cliente a
    // 180 dias con su reloj: se admite entre 170 y 181 dias despues de la escritura, lo que cubre un reloj algo desviado
    // y un mensaje que espero sin conexion hasta 10 dias, sin dejar que nadie lo conserve mas de lo previsto.
    function validMessage(d) {
      return d.keys().hasOnly(['teacherUid', 'studentUid', 'senderUid', 'text', 'createdAt', 'expireAt'])
        && d.keys().hasAll(['teacherUid', 'studentUid', 'senderUid', 'text', 'createdAt', 'expireAt'])
        && d.teacherUid is string && d.studentUid is string && d.senderUid == request.auth.uid
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 1000
        && d.createdAt == request.time && d.expireAt is timestamp
        && d.expireAt >= request.time + duration.value(170, 'd') && d.expireAt <= request.time + duration.value(181, 'd');
    }
    // Titulo de tarea: misma lista blanca que el nombre (sin control/formato ni espacios en los extremos), 1..120.
    function validTitle(n) {
      return n is string && n == n.trim() && n.size() >= 1 && n.size() <= 120
        && n.matches('^[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S} ]+$');
    }
    // Esquema cerrado de la tarea (espeja AssignmentRules en dominio). `doneAt` lo gobierna validDone.
    function validAssignment(d) {
      return d.keys().hasOnly(['teacherUid', 'title', 'description', 'dueAt', 'status', 'doneAt', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['teacherUid', 'title', 'status', 'createdAt', 'updatedAt'])
        && d.teacherUid is string && validTitle(d.title)
        && (!('description' in d) || (d.description is string && d.description.size() <= 1000))
        && (!('dueAt' in d) || d.dueAt is timestamp)
        && d.status in ['open', 'done'];
    }
    // Completar: doneAt == request.time; reabrir: sin doneAt.
    function validDone(d) {
      return (d.status == 'done' && d.doneAt == request.time) || (d.status == 'open' && !('doneAt' in d));
    }
    function validNotes(d) { return !('notes' in d) || (d.notes is string && d.notes.size() <= 500); }
    // Sin campos de audio posibles: hasOnly cierra el esquema.
    function validSession(d) {
      return d.keys().hasOnly(['startedAt', 'durationSec', 'instrument', 'notes', 'createdAt'])
        && d.keys().hasAll(['startedAt', 'durationSec', 'instrument', 'createdAt'])
        && d.startedAt is timestamp && d.startedAt > timestamp.date(2020, 1, 1)
        // Tolerancia de 10 min: el reloj del dispositivo puede ir adelantado y la escritura offline no se espera.
        && d.startedAt <= request.time + duration.value(10, 'm')
        && d.durationSec is int && d.durationSec >= 1 && d.durationSec <= 43200
        && d.startedAt + duration.value(d.durationSec, 's') <= request.time + duration.value(10, 'm')
        && d.instrument in ['violin', 'viola', 'cello', 'double_bass', 'other']
        && validNotes(d) && d.createdAt == request.time;
    }

    match /users/{uid} {
      // También en parental_pending (pantalla de espera): sin gating por email ni consentimiento.
      allow get: if isOwner(uid);
      // Escritura crítica (R-e): claim al día Y estado real en el doc, no solo el token.
      allow update: if isOwner(uid) && emailVerified() && hasConsent()
        && resource.data.consentStatus == 'granted'
        // Borrado en curso (design: users.deletion): el claim puede ir desfasado, se mira el doc.
        && !('deletion' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'instrument', 'locale'])
        && validEditable(request.resource.data);
      allow list, create, delete: if false;

      // Append-only y solo Functions: el dueño únicamente lee.
      match /consents/{id} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }

      // id <= 64: el cliente usa UUIDs (36).
      match /practiceSessions/{id} {
        // Profesor vinculado: solo lectura. Accesos: dueño 0; profesor 3 (3 get).
        // create/update llaman a userDocActive una vez (1 get); delete 0.
        allow get, list: if isOwner(uid) || isLinkedTeacher(uid);
        allow create: if id.size() <= 64 && isOwner(uid) && emailVerified() && hasConsent() && userDocActive(uid)
          && validSession(request.resource.data);
        allow update: if isOwner(uid) && emailVerified() && hasConsent() && userDocActive(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])
          && validNotes(request.resource.data);
        allow delete: if isOwner(uid); // supresión siempre disponible, sin consentimiento
      }

      // Tareas del profesor al alumno (REQ-ASG-01..04). El profesor opera solo mientras exista el vinculo (nunca por
      // claim) y solo sobre las que creo; el `list` del profesor DEBE filtrar `teacherUid == uid` (la regla mira
      // `resource.data`, que en una consulta exige la restriccion). Sin reglas de collectionGroup.
      // Accesos: profesor 3 get (isLinkedTeacher); alumno 0 en lectura, 1 get (userDocActive) al actualizar.
      match /assignments/{id} {
        allow get, list: if isOwner(uid) || (isLinkedTeacher(uid) && resource.data.teacherUid == request.auth.uid);
        allow create: if id.size() <= 64 && isLinkedTeacher(uid) && validAssignment(request.resource.data)
          && request.resource.data.teacherUid == request.auth.uid && request.resource.data.status == 'open'
          && !('doneAt' in request.resource.data)
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if (isLinkedTeacher(uid) && resource.data.teacherUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'dueAt', 'updatedAt'])
            && validAssignment(request.resource.data) && request.resource.data.updatedAt == request.time)
          || (isOwner(uid) && emailVerified() && hasConsent() && userDocActive(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt'])
            && validDone(request.resource.data));
        allow delete: if isLinkedTeacher(uid) && resource.data.teacherUid == request.auth.uid;
      }

      // Grabaciones y demostraciones (REQ-SEC-R01). Solo Admin escribe (finalizeRecording); el dueno solo lee y borra.
      // El doc de una demo del profesor vive aqui (en `users/{t}/recordings/{id}`, `objectPath` dice donde esta el objeto).
      // Los `list` exigen filtrar por `status == 'ready'` (profesor) o `sharedWith == uid && status == 'ready'` (alumno).
      // Accesos distintos por evaluacion: dueno 0; profesor 3 (vinculo + 2 usuarios, el `get` del alumno es el mismo de
      // userDocActive); destinatario de demo 1 (vinculo).
      match /recordings/{r} {
        allow get, list: if isOwner(uid)
          || (isLinkedTeacher(uid) && resource.data.status == 'ready'
            && recordingGranted(get(/databases/$(database)/documents/users/$(uid)).data))
          // Misma exigencia que storage.rules `demoReads`: claim `consentOk` + email verificado + vinculo (sin userDocActive).
          || (isSignedIn() && emailVerified() && hasConsent() && resource.data.get('sharedWith', '') == request.auth.uid
            && resource.data.status == 'ready' && linkOk(uid, request.auth.uid));
        allow create, update: if false;
        allow delete: if isOwner(uid); // A12: supresion siempre disponible, sin consentimiento

        // Revision del profesor (REQ-SEC-R02): id = uid del revisor (una por profesor). Solo Admin crea revisiones
        // anonimizadas (id aleatorio, `reviewerUid: null`). El alumno conserva la lectura tras desvincular (dueno).
        // El profesor lee/escribe SOLO la suya y mientras exista el vinculo; no hay `list` para el profesor (la regla
        // no puede acotar por id en una consulta). Accesos distintos: dueno 0; profesor 3 (isLinkedTeacher) y +1 en
        // `create` (doc de la grabacion) = 4, el maximo permitido por B3b.3.
        match /reviews/{reviewId} {
          allow get: if isOwner(uid) || (isLinkedTeacher(uid) && reviewId == request.auth.uid);
          allow list: if isOwner(uid);
          allow create: if isLinkedTeacher(uid) && reviewId == request.auth.uid
            && get(/databases/$(database)/documents/users/$(uid)/recordings/$(r)).data.status == 'ready'
            && recordingGranted(get(/databases/$(database)/documents/users/$(uid)).data)
            && validReview(request.resource.data) && request.resource.data.reviewerUid == request.auth.uid
            && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
          allow update: if isLinkedTeacher(uid) && reviewId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verdict', 'text', 'updatedAt'])
            && validReview(request.resource.data) && request.resource.data.updatedAt == request.time;
          allow delete: if isLinkedTeacher(uid) && reviewId == request.auth.uid;
        }
      }

      // Marcas de idempotencia del decremento del cupo (onRecordingDeleted): solo Admin SDK, ni el dueno las ve.
      match /recordingCountLedger/{id} { allow read, write: if false; }
    }

    // Colecciones del servidor (solo Admin SDK): deny explícito para que el test de registro las detecte.
    match /guardianRequests/{id} { allow read, write: if false; }
    match /guardianEmailLimits/{id} { allow read, write: if false; }
    match /mail/{id} { allow read, write: if false; }
    // Codigos de vinculo: ids HMAC, solo Functions (el profesor los lista via callable).
    match /teacherCodes/{id} { allow read, write: if false; }
    // Cursores de los trabajos diarios (purga/barrido de grabaciones): solo Functions.
    match /maintenance/{id} { allow read, write: if false; }
    // Interruptores en caliente (appConfig/features): los lee Functions; los clientes los reciben por identityConfig.
    match /appConfig/{id} { allow read, write: if false; }
    // Vinculos profesor-alumno: solo Functions escribe. Lectura por las partes; el `list` exige filtrar por el propio
    // uid (teacherUid o studentUid) para que la consulta quede acotada. Accesos por evaluacion: 0.
    match /teacherLinks/{id} {
      allow get, list: if isSignedIn() && emailVerified()
        && (resource.data.teacherUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }

    // Mensajes del chat de un vinculo (fase 4c). Coleccion de primer nivel con los dos uids en el doc: el `list` DEBE
    // filtrar `teacherUid == t` y `studentUid == s` (la regla mira `resource.data`). Sin edicion; el autor puede borrar
    // los suyos. Caen al desvincular (paso de removeLink), al borrar la cuenta de cualquiera de los dos y a los 180 dias
    // (TTL de `expireAt`). Accesos por evaluacion: 3 get; borrar, 0.
    match /chatMessages/{id} {
      allow get, list: if isChatParty(resource.data.teacherUid, resource.data.studentUid);
      allow create: if id.size() <= 64 && validMessage(request.resource.data)
        && isChatParty(request.resource.data.teacherUid, request.resource.data.studentUid);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
